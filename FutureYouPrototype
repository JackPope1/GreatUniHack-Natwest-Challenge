<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Future You: financial weather forecast</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1d1530; --muted:#706885; --line:#ece8f3; --soft:#f6f4fa; --bg:#f3f0f8; --card:#fff;
  --accent:#5b2a9c; --accent-2:#7a3fd1; --accent-soft:#efe8fa;
  --good:#0f8a5f; --good-soft:#e7f6ef; --storm:#c0264b; --storm-soft:#fdebef; --warn:#a66300; --warn-soft:#fff4dc;
  --fs:1;
}
body.contrast{ --ink:#000; --muted:#2b2b2b; --line:#777; --soft:#fff; --accent:#2c0060; --accent-2:#3d0080; --good:#005c3a; --storm:#8c0024; }
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:'Plus Jakarta Sans',Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:var(--bg);font-size:calc(15px*var(--fs));line-height:1.45;min-height:100vh}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
a{color:var(--accent-2)}
:focus-visible{outline:3px solid #f5a524;outline-offset:2px;border-radius:10px}
.sub{color:var(--muted);font-size:calc(13px*var(--fs))}
.stage{display:flex;gap:48px;justify-content:center;align-items:flex-start;padding:28px 20px 40px;flex-wrap:wrap}

/* phone */
.phone{width:400px;max-width:100%;height:840px;background:#fff;border-radius:44px;box-shadow:0 30px 80px -24px rgba(50,20,100,.35),0 0 0 10px #1c1430;position:relative;overflow:hidden;display:flex;flex-direction:column;flex:none}
@media (max-width:520px){ .stage{padding:0;gap:0} .phone{width:100%;height:100vh;height:100dvh;border-radius:0;box-shadow:none} .side{padding:24px} }
.status{height:32px;display:flex;justify-content:space-between;align-items:center;padding:0 28px;font-size:12px;font-weight:700;flex:none}
.top{padding:6px 22px 10px;display:flex;align-items:center;justify-content:space-between;flex:none}
.hello{font-size:calc(13px*var(--fs));color:var(--muted);font-weight:600}
.bal{font-size:calc(22px*var(--fs));font-weight:800;letter-spacing:-.01em}
.gear{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:var(--muted)}
.gear:hover{background:var(--soft)}
.screen{flex:1;overflow-y:auto;padding:4px 18px 16px;scroll-behavior:smooth}
.tabs{display:flex;border-top:1px solid var(--line);flex:none;padding:6px 10px 16px;background:#fff}
.tab{flex:1;padding:8px 4px 2px;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:calc(12px*var(--fs));font-weight:600;color:var(--muted)}
.tab svg{width:22px;height:22px}
.tab[aria-selected=true]{color:var(--accent)}

/* chat */
.chat{display:flex;flex-direction:column;gap:14px;padding:6px 0 4px}
.msg.me{align-self:flex-end;max-width:82%;background:var(--accent);color:#fff;padding:9px 14px;border-radius:18px 18px 4px 18px;font-size:calc(14.5px*var(--fs))}
.msg.ai{align-self:stretch;display:flex;gap:10px}
.av{width:28px;height:28px;border-radius:50%;flex:none;background:linear-gradient(135deg,#5b2a9c,#0f8a5f);color:#fff;display:grid;place-items:center;font-size:13px;font-weight:800;margin-top:1px}
.ai .body{flex:1;min-width:0;font-size:calc(14.5px*var(--fs))}
.ai .body b{color:var(--accent)}
.ai .why{margin-top:6px;font-size:calc(11.5px*var(--fs));color:var(--muted)}
.typing span{display:inline-block;width:6px;height:6px;border-radius:50%;background:#a99bc4;margin:8px 2px 0;animation:b 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
@keyframes b{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.composer{flex:none;padding:8px 14px 6px;border-top:1px solid var(--line);background:#fff}
.replies{display:flex;gap:6px;overflow-x:auto;padding:2px 0 8px;scrollbar-width:none}
.replies::-webkit-scrollbar{display:none}
.qr{flex:none;border:1.5px solid var(--accent-soft);color:var(--accent);background:#fff;border-radius:999px;padding:7px 13px;font-size:calc(13px*var(--fs));font-weight:700;white-space:nowrap}
.qr:hover{background:var(--accent-soft)}
.inrow{display:flex;gap:8px;align-items:center}
.inrow input{flex:1;border:0;background:var(--soft);border-radius:999px;padding:12px 16px;font:inherit;font-size:calc(14.5px*var(--fs))}
.send{width:42px;height:42px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;flex:none}
.aitag{font-size:calc(11px*var(--fs));color:var(--muted);padding:0 4px 6px;display:flex;justify-content:space-between}
.aitag button{color:var(--accent-2);font-weight:700;font-size:inherit}

/* cards inside chat */
.cx{margin-top:10px;background:var(--soft);border-radius:18px;padding:14px}
.cx h4{margin:0;font-size:calc(15px*var(--fs))}
.big{font-size:calc(26px*var(--fs));font-weight:800;letter-spacing:-.01em;line-height:1.1}
.cx .row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.cx-head{display:flex;gap:12px;align-items:center;margin-bottom:6px}
.wxi{font-size:30px;line-height:1}
.weeks{display:grid;grid-template-columns:repeat(12,1fr);gap:2px;margin-top:6px;text-align:center}
.weeks div{font-size:calc(10px*var(--fs));color:var(--muted);line-height:1.2}
.weeks div span{display:block;font-size:16px}
.link{color:var(--accent-2);font-weight:700;font-size:calc(13px*var(--fs));margin-top:8px}
.list{margin:6px 0 0;padding:0;list-style:none}
.list li{padding:7px 0;border-top:1px solid var(--line);font-size:calc(13.5px*var(--fs))}
.list li:first-child{border-top:0}
.fx{display:flex;gap:10px;align-items:center;padding:9px 0;border-top:1px solid var(--line)}
.fx:first-of-type{border-top:0}
.fx .t{flex:1;min-width:0}
.fx .t b{display:block;color:var(--ink);font-size:calc(14px*var(--fs))}
.fx .t span{font-size:calc(12px*var(--fs));color:var(--muted)}
.add{border-radius:999px;padding:6px 12px;font-weight:800;font-size:calc(12.5px*var(--fs));background:var(--accent);color:#fff;flex:none}
.add.on{background:var(--good-soft);color:var(--good)}
.btn{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:9px 15px;font-weight:800;font-size:calc(13px*var(--fs));background:var(--accent);color:#fff}
.btn.ghost{background:#fff;color:var(--accent);border:1.5px solid var(--accent-soft)}
.btn.good{background:var(--good)}
.vs{display:flex;align-items:baseline;gap:8px}
.vs s{color:var(--muted);font-size:calc(18px*var(--fs));font-weight:700}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:6px 11px;font-size:calc(12.5px*var(--fs));font-weight:600}
.chip[aria-pressed=true]{border-color:var(--accent);background:var(--accent);color:#fff}
.bar{height:8px;border-radius:8px;background:#e6e0ef;overflow:hidden;margin:8px 0 4px}.bar span{display:block;height:100%;background:var(--good);border-radius:8px}
.good{color:var(--good)} .bad{color:var(--storm)}
.legend{display:flex;gap:12px;font-size:calc(11px*var(--fs));color:var(--muted);margin-top:2px}
.legend i{display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:4px;vertical-align:middle}
svg[role=img]{display:block;width:100%;height:auto}
.gear svg{width:22px;height:22px}.send svg{width:18px;height:18px}

/* forecast + plan tabs */
.h2{font-size:calc(20px*var(--fs));font-weight:800;margin:10px 0 2px}
.seg{display:flex;background:var(--soft);border-radius:12px;padding:3px;margin:12px 0 8px}
.seg button{flex:1;border-radius:9px;padding:8px;font-weight:700;font-size:calc(13px*var(--fs));color:var(--muted)}
.seg button[aria-pressed=true]{background:#fff;color:var(--accent);box-shadow:0 1px 4px rgba(60,20,110,.12)}
.weekrow{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:10px}
.wk{border-radius:12px;padding:6px 0;text-align:center;font-size:calc(11px*var(--fs));color:var(--muted);background:var(--soft);border:2px solid transparent}
.wk span{display:block;font-size:19px;line-height:1.3}
.wk[aria-pressed=true]{border-color:var(--accent);background:#fff}
.panel{background:var(--soft);border-radius:18px;padding:14px;margin-top:12px}
.prow{display:flex;gap:12px;align-items:center;padding:11px 0;border-top:1px solid var(--line)}
.prow:first-child{border-top:0}
.prow .t{flex:1;min-width:0}.prow .t b{display:block;font-size:calc(14px*var(--fs))}.prow .t span{font-size:calc(12px*var(--fs));color:var(--muted)}
.tg{width:46px;height:28px;border-radius:28px;background:#d9d2e4;position:relative;flex:none;transition:background .2s}
.tg::after{content:"";position:absolute;width:22px;height:22px;border-radius:50%;background:#fff;top:3px;left:3px;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tg[aria-checked=true]{background:var(--good)} .tg[aria-checked=true]::after{left:21px}
details{margin-top:12px;background:var(--soft);border-radius:18px;padding:12px 14px}
details summary{font-weight:700;cursor:pointer;font-size:calc(14px*var(--fs))}
details ul{margin:8px 0 0;padding-left:18px;font-size:calc(13px*var(--fs))}

/* sheets, toast */
.sheet-bg{position:absolute;inset:0;background:rgba(20,10,35,.4);display:flex;align-items:flex-end;z-index:20}
.sheet{background:#fff;width:100%;border-radius:24px 24px 0 0;padding:20px 20px 26px;max-height:86%;overflow:auto}
.sheet h2{margin:0 0 10px;font-size:calc(18px*var(--fs))}
.opt{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid var(--line);gap:12px}
.draft{background:var(--soft);border-radius:14px;padding:12px;white-space:pre-wrap;font-size:calc(13.5px*var(--fs));margin:8px 0 12px}
.toast{position:absolute;left:16px;right:16px;bottom:96px;background:#1d1430;color:#fff;border-radius:14px;padding:11px 14px;font-size:13px;font-weight:600;z-index:30;opacity:0;transform:translateY(10px);transition:.25s;pointer-events:none}
.toast.show{opacity:1;transform:none}

/* side panel */
.side{width:420px;max-width:100%;flex:none;padding-top:20px}
.kick{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-2)}
.side h1{font-size:40px;line-height:1.05;margin:8px 0 10px;letter-spacing:-.02em;color:var(--accent)}
.side .lead{font-size:16px;color:var(--muted);margin:0 0 16px}
.persona{display:flex;gap:12px;align-items:center;margin:18px 0}
.avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#f3c9a6,#b8763f);display:grid;place-items:center;font-size:22px;flex:none}
.side details{background:#fff}
.side details p,.side details li{font-size:13.5px;color:var(--ink)}
.small{font-size:12.5px;color:var(--muted)}

/* presenter mode */
.spot{position:relative;z-index:6;box-shadow:0 0 0 3px #f5a524,0 0 0 9999px rgba(29,20,48,.28)!important;border-radius:18px}
body.touring .side{width:620px}
.tourpanel .tstep{font-size:20px;font-weight:800;color:var(--accent-2);margin:16px 0 6px}
.tourpanel .tstep span{color:var(--muted);font-weight:600}
.tourpanel .ttitle{font-size:54px;line-height:1.05;letter-spacing:-.02em;margin:0 0 18px;color:var(--accent)}
.tourpanel .ttext{font-size:26px;line-height:1.45;margin:0 0 26px}
.tourpanel .ttext b{color:var(--accent-2)}
.tbar{height:6px;border-radius:6px;background:#e3dbef;overflow:hidden;margin-bottom:18px}.tbar span{display:block;height:100%;background:linear-gradient(90deg,#5b2a9c,#0f8a5f);transition:width .4s}
.tctl{display:flex;gap:8px;flex-wrap:wrap}
body.recording .tctl, body.recording .tourpanel .small{display:none}
body.recording .stage{min-height:100vh;align-items:center;padding:0 40px;gap:80px}
body.recording .side{width:680px;padding-top:0}
body.recording .tourpanel .ttitle{font-size:64px}
body.recording .tourpanel .ttext{font-size:31px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
body.nomotion *{transition:none!important;animation:none!important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
<body>
<div class="stage">
  <main class="phone" id="phone" aria-label="Future You app prototype">
    <div class="status" aria-hidden="true"><span>9:41</span><span>5G ▮</span></div>
    <header class="top">
      <div><div class="hello" id="hello"></div><div class="bal" id="bal"></div></div>
      <button class="gear" data-act="settings" aria-label="Display and language settings"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
    </header>
    <div class="screen" id="screen" tabindex="-1"></div>
    <div id="composer"></div>
    <nav class="tabs" role="tablist" aria-label="Sections" id="tabs"></nav>
    <div id="sheet"></div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </main>
  <aside class="side" id="side"></aside>
</div>

<script>
/* ===================================================================
   Future You — forecast engine
   Pure JS, no dependencies. Runs in the browser and in Node (for tests).
   Pipeline: synthetic history -> analyse() learns patterns ->
             simulate() Monte Carlo forecast -> findStorms() -> explain
   =================================================================== */

// ---------- date helpers (day numbers = days since 1970-01-01 UTC) ----------
const dn = (y, m, d) => Date.UTC(y, m - 1, d) / 864e5;
function ymd(n) {
  const t = new Date(n * 864e5);
  return { y: t.getUTCFullYear(), m: t.getUTCMonth() + 1, d: t.getUTCDate(), wd: t.getUTCDay() };
}
const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const DOWL = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const MONL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
function fmtDay(n, long) {
  const a = ymd(n);
  return long ? `${DOWL[a.wd]} ${a.d} ${MONL[a.m - 1]}` : `${DOW[a.wd]} ${a.d} ${MON[a.m - 1]}`;
}
function daysInMonth(y, m) { return new Date(Date.UTC(y, m, 0)).getUTCDate(); }
// half-month bucket 0..23, used for seasonality
// UC due on a weekend is paid on the Friday before
const ucPayDate = (y, m, day) => { const d = dn(y, m, day), w = ymd(d).wd; return w === 6 ? d - 1 : w === 0 ? d - 2 : d; };
const bucket = n => { const a = ymd(n); return (a.m - 1) * 2 + (a.d > 15 ? 1 : 0); };

// ---------- seeded randomness ----------
function mulberry32(a) {
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function gauss(r) { let u = 0, v = 0; while (!u) u = r(); while (!v) v = r(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }
const r2 = x => Math.round(x * 100) / 100;

// ---------- the persona ----------
const PERSONA = {
  name: 'Jane',
  full: 'Jane Doe, 31',
  place: 'Manchester',
  blurb: 'Food-delivery rider on an e-bike and single mum to Leo (6). Gets Universal Credit and Child Benefit. Her income changes every week.',
  today: dn(2026, 11, 7),
  balanceToday: 214.37,
  // What Jane told the app: QuickCash loan has payments until mid-April (from her loan agreement)
  knownEnds: { 'QUICKCASH LOANS': dn(2027, 4, 16) },
  // From her UC award statement (user-entered, illustrative figures)
  uc: { maxAward: 1210, workAllowance: 427, childcareCap: 1071.09, taper: 0.55, payDay: 16, apStartDay: 10 },
};

const HOLIDAYS = [ // school holidays (illustrative Manchester term dates)
  [dn(2025, 12, 20), dn(2026, 1, 4)], [dn(2026, 2, 16), dn(2026, 2, 20)], [dn(2026, 3, 30), dn(2026, 4, 10)],
  [dn(2026, 5, 25), dn(2026, 5, 29)], [dn(2026, 7, 22), dn(2026, 9, 2)], [dn(2026, 10, 26), dn(2026, 10, 30)],
  [dn(2026, 12, 19), dn(2027, 1, 3)],
];
const inHoliday = d => HOLIDAYS.some(([a, b]) => d >= a && d <= b);

// How busy delivery work is by time of year (hidden truth the model must learn)
function workSeason(d) {
  const { m, d: day } = ymd(d);
  if (m === 12) return day <= 21 ? 1.32 : day <= 27 ? 0.35 : 0.85;
  if (m === 1) return day <= 4 ? 0.85 : 0.64;
  if (m === 2) return 0.82;
  if (m === 3) return 0.92;
  if (m >= 4 && m <= 6) return 0.97;
  if (m === 7 || m === 8) return 0.84;
  if (m === 11) return 1.06;
  return 1.0;
}

function generateHistory() {
  const r = mulberry32(20261107);
  const start = dn(2025, 11, 1), end = PERSONA.today - 1;
  const tx = [];
  const add = (d, desc, amt, cat) => { if (d >= start && d <= end) tx.push({ d, desc, amt: r2(amt), cat }); };
  const u = PERSONA.uc;

  // 1) gig payouts (Wednesdays, for previous week's work). Start a month early for UC.
  const payouts = [];
  for (let d = start - 40; d <= end; d++) {
    if (ymd(d).wd !== 3) continue;
    let amt = 238 * workSeason(d - 6) * Math.exp(gauss(r) * 0.15);
    if (r() < 0.045) amt *= 0.3; // ill / bike broken
    amt = r2(amt);
    payouts.push({ d, amt });
    add(d, 'ROOWAY RIDER PAYOUT', amt, 'income');
  }
  // 2) Universal Credit on the 16th, based on earnings in the assessment period
  for (let d = start; d <= end; d++) {
    const a0 = ymd(d), a = { ...a0 };
    if (a0.d > 20 || d !== ucPayDate(a0.y, a0.m, u.payDay)) continue;
    const apEnd = dn(a.y, a.m, u.apStartDay - 1), apStart = dn(a.m === 1 ? a.y - 1 : a.y, a.m === 1 ? 12 : a.m - 1, u.apStartDay);
    const earn = payouts.filter(p => p.d >= apStart && p.d <= apEnd).reduce((s, p) => s + p.amt, 0);
    add(d, 'DWP UNIVERSAL CREDIT', Math.max(0, u.maxAward - u.taper * Math.max(0, earn - u.workAllowance)), 'income');
  }
  // 3) Child Benefit, every 4 weeks
  for (let d = dn(2025, 11, 3); d <= end; d += 28) add(d, 'HMRC CHILD BENEFIT', 104.2, 'income');

  // 4) bills + everyday spending
  for (let d = start; d <= end; d++) {
    const a = ymd(d), wd = a.wd;
    if (a.d === 1) add(d, 'OAKWOOD LETTINGS RENT', -725, 'Housing');
    if (a.d === 1 && !(a.m === 2 || a.m === 3)) add(d, 'CITY COUNCIL CTAX', -118, 'Council tax');
    if (a.d === 3) add(d, 'RIDESAFE BIKE INSURANCE', -42, 'Work costs');
    if (a.d === 5) add(d, 'BRIGHTGRID ENERGY', -96, 'Energy');
    if (a.d === 9) add(d, 'STREAMFLIX', d >= dn(2026, 8, 1) ? -10.99 : -8.99, 'Subscriptions');
    if (a.d === 12) add(d, 'FIBRELINK BROADBAND', -30, 'Phone & internet');
    if (a.d === 14) add(d, 'TUNEBOX MUSIC', -11.99, 'Subscriptions');
    if (a.d === 20) add(d, 'FITLIFE GYM', -24.99, 'Subscriptions');
    if (a.d === 22) add(d, 'SKYWAVE MOBILE', -38, 'Phone & internet');
    if (a.d === 25) add(d, 'CLEARPATH CARD PAYMENT', -45, 'Debt');
    if (wd === 5 && d >= dn(2026, 9, 18)) add(d, 'QUICKCASH LOANS', -32, 'Debt'); // taken out after September overdraft

    const hol = inHoliday(d);
    const xmas = a.m === 12 && a.d <= 24;
