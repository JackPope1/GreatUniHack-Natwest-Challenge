function parseDate(t){
  t = t.toLowerCase(); const today = P.today;
  if (/\btoday|now\b/.test(t)) return today;
  if (/tomorrow/.test(t)) return today + 1;
  if (/next week/.test(t)) return today + 7;
  const mm = t.match(/(\d{1,2})(st|nd|rd|th)?\s*(of\s*)?(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/) || t.match(/(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\w*\s*(\d{1,2})/);
  if (mm) { const mon = isNaN(+mm[1]) ? mm[1] : mm[4], day = isNaN(+mm[1]) ? +mm[2] : +mm[1]; const mi = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'].indexOf(mon) + 1; let d = E.dn(E.ymd(today).y, mi, day); if (d < today) d = E.dn(E.ymd(today).y + 1, mi, day); return d; }
  const full = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
  for (let i = 0; i < 7; i++) if (t.includes(full[i])) { let d = today + 1; while (E.ymd(d).wd !== i) d++; return d; }
  return today;
}
function route(q){
