// ---------- analyse: learn the patterns from history ----------
const median = a => { const s = [...a].sort((x, y) => x - y); const n = s.length; return n ? (n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2) : 0; };
const mean = a => a.length ? a.reduce((s, x) => s + x, 0) / a.length : 0;
const std = a => { const m = mean(a); return Math.sqrt(mean(a.map(x => (x - m) ** 2))); };

function analyse(allTx, asOf) {
  const tx = allTx.filter(t => t.d < asOf);
  const histStart = tx[0].d;
  const balanceAt = (() => { let b = null; for (const t of tx) b = t.bal; return b; })();

  // group by merchant
  const groups = {};
  for (const t of tx) (groups[t.desc + (t.amt > 0 ? '|in' : '|out')] ||= []).push(t);

  const recurring = [], incomeStreams = [], episodic = [];
  const recurringDesc = new Set();
  for (const [key, list] of Object.entries(groups)) {
    if (list.length < 3) continue;
    const ds = list.map(t => t.d);
    const gaps = ds.slice(1).map((d, i) => d - ds[i]);
    const g = median(gaps);
    const amts = list.map(t => Math.abs(t.amt));
    const last3 = amts.slice(-3);
    const cv = std(last3) / mean(last3);
    let cadence = null, consistency = 0, anchor = null;
    if (g >= 6 && g <= 8) { cadence = 'weekly'; consistency = gaps.filter(x => x === 7).length / gaps.length; anchor = ymd(ds[ds.length - 1]).wd; }
    else if (g >= 27 && g <= 29 && gaps.filter(x => x === 28).length / gaps.length > 0.8) { cadence = '4-weekly'; consistency = gaps.filter(x => x === 28).length / gaps.length; anchor = ds[ds.length - 1]; }
    else if (g >= 26 && g <= 35) {
      cadence = 'monthly';
      const doms = ds.map(d => ymd(d).d); const md = median(doms);
      consistency = doms.filter(x => Math.abs(x - md) <= 2).length / doms.length; anchor = Math.round(md);
    }
    if (cadence === 'weekly' && consistency < 0.7 && !key.endsWith('|in') && std(amts) / mean(amts) < 0.03) {
      // weekly cost that only happens at certain times of year (e.g. holiday camp)
      episodic.push({ desc: list[0].desc, cat: list[0].cat, anchor: ymd(ds[ds.length - 1]).wd, amount: amts[amts.length - 1], dates: ds, first: ds[0] });
      recurringDesc.add(list[0].desc);
      continue;
    }
    if (!cadence || consistency < (cadence === 'weekly' ? 0.7 : 0.55)) continue;
    const period = cadence === 'weekly' ? 7 : 31;
    if (asOf - ds[ds.length - 1] > period * 1.5 + 3) continue; // stream no longer active
    const isIn = key.endsWith('|in');
    const item = {
      desc: list[0].desc, cat: list[0].cat, cadence, anchor, consistency,
      amount: amts[amts.length - 1], variable: cv > 0.08 || std(amts) / mean(amts) > 0.25, count: list.length,
      first: ds[0], last: ds[ds.length - 1], dates: ds, amounts: amts, isIn,
    };
    // price change detection
    const prev = amts.slice(0, -1).filter(x => Math.abs(x - item.amount) > 0.005);
    if (!item.variable && prev.length && Math.abs(amts[amts.length - 2] - item.amount) < 0.005 && prev.length < amts.length - 1) {
      const lastDiff = [...list].reverse().find(t => Math.abs(Math.abs(t.amt) - item.amount) > 0.005);
      if (lastDiff) item.priceChange = { from: Math.abs(lastDiff.amt), to: item.amount, since: list.find(t => t.d > lastDiff.d).d };
    }
    if (isIn) { if (!incomeStreams.length || true) incomeStreams.push(item); }
    else if (!item.variable) { recurring.push(item); recurringDesc.add(item.desc); }
  }
  recurring.sort((a, b) => b.amount - a.amount);

  // gig income: weekly variable credit stream
  const gig = incomeStreams.find(s => s.cadence === 'weekly' && s.variable);
  const uc = incomeStreams.find(s => /UNIVERSAL CREDIT/.test(s.desc));
  const cb = incomeStreams.find(s => s !== gig && s !== uc && !s.variable);

  // seasonality of gig income, half-month buckets
  const gList = groups[gig.desc + '|in'];
  const overall = mean(gList.map(t => t.amt));
  const gBuck = Array.from({ length: 24 }, () => []);
  for (const t of gList) gBuck[bucket(t.d - 6)].push(t.amt);
  const gFactor = gBuck.map(a => a.length ? mean(a) / overall : 1);
  const gResid = gList.map(t => t.amt / (overall * gFactor[bucket(t.d - 6)]));
  const recent = gList.slice(-8);
  const gLevel = mean(recent.map(t => t.amt / gFactor[bucket(t.d - 6)]));

  // flexible spending = debits not in fixed recurring streams
  const flexByDay = new Map();
  for (const t of tx) if (t.amt < 0 && !recurringDesc.has(t.desc)) flexByDay.set(t.d, (flexByDay.get(t.d) || 0) - t.amt);
  const flexDay = d => flexByDay.get(d) || 0;
  // annual one-offs: big payments last year that may come round again
  const annual = [];
  for (const [key, list] of Object.entries(groups)) {
    if (key.endsWith('|in') || recurringDesc.has(list[0].desc)) continue;
    for (const t of list) if (-t.amt >= 100 && t.d + 365 >= asOf) annual.push({ desc: t.desc, cat: t.cat, d: t.d, amount: -t.amt });
  }
  for (const a of annual) recurringDesc.add(a.desc);
  for (const a of annual) flexByDay.set(a.d, (flexByDay.get(a.d) || 0) - a.amount);

  const fBuck = Array.from({ length: 24 }, () => []);
  for (let d = histStart; d < asOf; d++) fBuck[bucket(d)].push(flexDay(d));
  const fOverall = mean(fBuck.flat());
  const fFactor = fBuck.map(a => a.length >= 7 ? mean(a) / fOverall : 1);
  // bootstrap pool: last 84 days, by weekday, de-seasonalised
  const pool = Array.from({ length: 7 }, () => []);
  for (let d = asOf - 84; d < asOf; d++) pool[ymd(d).wd].push(flexDay(d) / fFactor[bucket(d)]);
  const flexBase = mean(pool.flat());

  // category totals (last 90 days) for insights
  const cats = {};
  for (const t of tx) if (t.amt < 0 && t.d >= asOf - 91) cats[t.cat] = (cats[t.cat] || 0) - t.amt;
  // takeaway weekly average
  const takeaway = (cats['Takeaways'] || 0) / 13;

  // Christmas: last year's early-December extra
  let xmasExtra = 0, xmasLastYear = null;
  const lyDec = dn(ymd(asOf).y - 1, 12, 1);
  if (lyDec >= histStart) {
    const decSpend = []; for (let d = lyDec; d < lyDec + 24; d++) decSpend.push(flexDay(d));
    const nov = []; for (let d = lyDec - 30; d < lyDec; d++) if (d >= histStart) nov.push(flexDay(d));
    xmasExtra = decSpend.reduce((s, x) => s + x, 0) - mean(nov) * 24;
    xmasLastYear = tx.filter(t => t.cat === 'Christmas' && t.d >= lyDec && t.d < lyDec + 24).reduce((s, t) => s - t.amt, 0);
  }

  // last January low point
  let janLow = null;
  const lyJan = dn(ymd(asOf).y, 1, 1);
  for (const t of tx) if (t.d >= lyJan && t.d < lyJan + 31 && (janLow === null || t.bal < janLow.bal)) janLow = { d: t.d, bal: t.bal };

  return {
    asOf, balance: balanceAt, histStart, txCount: tx.length, recurring, episodic, annual, gig, uc, cb,
    gFactor, gResid, gLevel, gOverall: overall, gList,
    fFactor, pool, flexBase, cats, takeaway, xmasExtra, xmasLastYear, janLow,
    ucParams: PERSONA.uc, lastUC: uc ? uc.amount : 0,
  };
}

