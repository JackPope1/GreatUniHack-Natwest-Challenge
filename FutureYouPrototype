const WHEN = { next:{ l:'next week', d:P.today + 7 }, dec:{ l:'in early December', d:E.dn(2026, 12, 7) }, feb:{ l:'in February', d:E.dn(2027, 2, 8) }, may:{ l:'in May', d:E.dn(2027, 5, 10) } };
