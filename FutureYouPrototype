async function askClaude(q){
  me(q);
  const m = say('<span class="typing"><span></span><span></span><span></span></span>', [], []); m.live = true;
  S.busy = true; render();
  const used = [];
  const tools = aiTools(m).map(t => ({ ...t, execute:input => { used.push(t.name); return t.execute(input || {}); } }));
  const hist = S.chat.filter(x => x !== m).slice(-12).map(x => ({ role:x.who === 'me' ? 'user' : 'assistant', content:x.text || stripTags(x.html) })).filter(x => x.content.trim());
  while (hist.length && hist[0].role !== 'user') hist.shift();
  const msgs = []; for (const h of hist) { if (msgs.length && msgs[msgs.length-1].role === h.role) msgs[msgs.length-1].content += '\n' + h.content; else msgs.push({ ...h }); }
  msgs[0] = { role:'user', content:aiInstructions() + '\n\n---\nJane: ' + msgs[0].content };
  try {
    const r = await SAMPLE(msgs, { tools, cache:false, onText:({ text }) => { m.text = text; m.html = md(text); const el = document.querySelector(`[data-mid="${m.id}"] .txt`); if (el) { el.innerHTML = m.html; scrollChat(); } } });
    m.text = r.text; m.html = md(r.text);
    const u = [...new Set(used)].filter(n => n !== 'show_card');
    m.why = u.length ? `Claude checked: ${u.map(n => n.replace(/_/g, ' ')).join(', ')}` : 'Claude';
    S.replies = DEFAULT_REPLIES;
  } catch (e) {
    if (e && e.code === 'not_granted') { SAMPLE = null; AI = 'off'; }
    S.chat.splice(S.chat.indexOf(m), 1); S.chat.pop();
    me(q); route(q);
    S.chat[S.chat.length - 1].why = 'Built-in coach (live AI unavailable)';
  }
  S.busy = false; render();
}
function userAsk(q, viaChip){
  q = q.trim(); if (!q || S.busy) return;
  if (!viaChip && SAMPLE && S.live) return askClaude(q);
  me(q);
  if (S.instant || !S.motion) { route(q); render(); speakLast(); return; }
  S.busy = true; S.typingNow = true; render();
  setTimeout(() => { S.typingNow = false; S.busy = false; route(q); render(); speakLast(); }, 450);
}
function speakLast(){
  if (!S.speak) return;
  try { const m = [...S.chat].reverse().find(x => x.who === 'ai'); speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(stripTags(m.html)); u.lang = 'en-GB'; speechSynthesis.speak(u); } catch (_) {}
}

