  const days = [];
  let anyNeg = 0;
  const runNeg = new Uint8Array(N), runMin = new Float32Array(N).fill(Infinity), runWin = new Uint8Array(N);
  const win = opts.window || null; // [fromDay, toDay]: chance of running out inside this window
  const col = new Float32Array(N), scol = new Float32Array(N);
  for (let k = 0; k < H; k++) {
    let neg = 0, low = 0;
    const inWin = win && start + k >= win[0] && start + k <= win[1];
    for (let i = 0; i < N; i++) { const v = bal[i * H + k]; col[i] = v; if (v < runMin[i]) runMin[i] = v; if (v < 0) { neg++; runNeg[i] = 1; if (inWin) runWin[i] = 1; } if (v < 75) low++; }
    col.sort();
    const q = p => col[Math.min(N - 1, Math.floor(p * N))];
    const day = { d: start + k, p10: q(0.1), p25: q(0.25), p50: q(0.5), p75: q(0.75), p90: q(0.9), pNeg: neg / N, pLow: low / N, bills: sched[k] };
    if (shieldArr) { for (let i = 0; i < N; i++) scol[i] = shieldArr[i * H + k]; scol.sort(); day.sh50 = scol[Math.floor(N / 2)]; day.sh10 = scol[Math.floor(N * 0.1)]; }
    days.push(day);
  }
  const mins = Array.from(runMin).sort((x, y) => x - y);
  for (let i = 0; i < N; i++) anyNeg += runNeg[i];
  const med = o => { const out = {}; for (const [k, v] of Object.entries(o)) out[k] = median(v); return out; };
  const res = { days, pAny: anyNeg / N, ucMed: med(ucPaid), gigMed: med(gigPaid), scen, H, start, target,
    worstMed: mins[Math.floor(N / 2)], worst10: mins[Math.floor(N * 0.1)] };
  if (sh) { res.shieldUsed = shieldUsedRuns / N; res.shieldEndMed = median(shieldEnd); }
  if (win) { let c = 0; for (let i = 0; i < N; i++) c += runWin[i]; res.pWin = c / N; const wd = days.filter(x => x.d >= win[0] && x.d <= win[1]); res.lowWin = Math.min(...wd.map(x => x.p50)); res.low10Win = Math.min(...wd.map(x => x.p10)); }
  res.weather = days.map(weatherOf);
  res.riskDays = days.filter(x => x.pNeg >= 0.15).length;
  res.expNeg = days.reduce((s, x) => s + x.pNeg, 0);
  res.lowMed = Math.min(...days.map(x => x.p50));
  res.lowDay = days.reduce((m, x) => x.p50 < m.p50 ? x : m, days[0]).d;
  res.storms = findStorms(res, model);
  return res;
}

function weatherOf(x) {
  if (x.pNeg >= 0.4) return 'storm';
  if (x.pNeg >= 0.15) return 'rain';
  if (x.pLow >= 0.4) return 'cloud';
  return 'sun';
}

// ---------- storms + explanations ----------
function findStorms(res, model) {
  const out = []; let cur = null;
  res.days.forEach((x, k) => {
    if (x.pNeg >= 0.15) {
      if (cur && k - cur.endK <= 6) { cur.endK = k; }
      else { cur = { startK: k, endK: k }; out.push(cur); }
    }
  });
  return out.map((s, idx) => {
    const span = res.days.slice(s.startK, s.endK + 1);
    const peak = span.reduce((m, x) => x.pNeg > m.pNeg ? x : m, span[0]);
    const lowest = span.reduce((m, x) => x.p50 < m.p50 ? x : m, span[0]);
    return {
      id: 's' + idx, start: span[0].d, end: span[span.length - 1].d, peak: peak.d, pPeak: peak.pNeg,
      lowMed: lowest.p50, lowP10: Math.min(...span.map(x => x.p10)), severity: peak.pNeg >= 0.4 ? 'storm' : 'rain',
      drivers: explainStorm(res, model, span[0].d, peak.d),
    };
  });
}

function explainStorm(res, model, startD, peakD) {
  const drivers = [];
  const from = Math.max(res.start, startD - 10);
  // big bills in the run-up
  const bills = [];
  for (let d = from; d <= peakD; d++) for (const e of res.days[d - res.start].bills) if (-e.amt >= 25) bills.push({ d, label: e.label, amt: -e.amt });
  const billTotal = bills.reduce((s, b) => s + b.amt, 0);
  if (bills.length) drivers.push({ type: 'bills', icon: '📤', total: billTotal, items: bills,
    text: `£${Math.round(billTotal)} of bills leave between ${fmtDay(bills[0].d)} and ${fmtDay(bills[bills.length - 1].d)}`, });
  // timing gap to next big income
  const ucDays = Object.keys(res.ucMed).map(Number).filter(d => d >= peakD).sort((a, b) => a - b);
  if (ucDays.length) {
    const nd = ucDays[0];
    drivers.push({ type: 'timing', icon: '⏳', d: nd, amt: res.ucMed[nd],
      text: `Your Universal Credit (about £${Math.round(res.ucMed[nd])}) doesn't arrive until ${fmtDay(nd)}${nd - peakD > 1 ? `, ${nd - peakD} days later` : ''}` });
  }
  // lower UC in window
  for (const [dS, v] of Object.entries(res.ucMed)) {
    const d = +dS;
    if (d >= from - 20 && d <= peakD + 3 && v < model.lastUC - 60) {
      drivers.push({ type: 'uc', icon: '🏛️', amt: model.lastUC - v,
        text: `Universal Credit likely about £${Math.round(model.lastUC - v)} lower on ${fmtDay(d)}. You usually earn more from mid-November to early December, and UC goes down when your earnings go up` });
    }
  }
  // christmas spending
  let xmas = 0;
  for (let d = from; d <= peakD; d++) { const a = ymd(d); const f = model.fFactor[bucket(d)]; if (a.m === 12 && a.d <= 24 && f > 1) xmas += model.flexBase * (f - 1) * (res.scen.xmas && model.xmasExtra > 200 ? 200 / model.xmasExtra : 1); }
  if (xmas > 60) drivers.push({ type: 'xmas', icon: '🎁', amt: xmas,
    text: `Christmas shopping: last December you spent about £${Math.round(model.xmasLastYear || xmas)} on gifts in the first three weeks` });
  // slow gig weeks
  const gigs = Object.entries(res.gigMed).filter(([d]) => +d >= from && +d <= peakD + 3).map(([, v]) => v);
  const typical = model.gLevel * mean(model.gFactor);
  if (gigs.length && mean(gigs) < typical * 0.85 && !res.scen.steady) drivers.push({ type: 'gig', icon: '🚲', amt: typical - mean(gigs),
    text: `Delivery pay is usually about ${Math.round((1 - mean(gigs) / typical) * 100)}% lower around now. Last year it dropped after Christmas` });
  return drivers;
}

// impact of each fix alone
function fixImpacts(model, base, opts) {
  const out = {};
  for (const f of FIXES) {
    const r = simulate(model, { [f.id]: true }, opts);
    out[f.id] = { dAny: base.pAny - r.pAny, dRisk: base.riskDays - r.riskDays, dLow: r.lowMed - base.lowMed, dExp: base.expNeg - r.expNeg };
  }
  return out;
}

// "can I afford X on day D?" — compares futures with and without the purchase
function affordCheck(model, scen, opts, amt, d) {
  const base = simulate(model, scen, opts);
  const withIt = simulate(model, scen, { ...opts, extra: { d, amt } });
  // which storm gets worse the most?
  let worst = null;
  for (const st of withIt.storms.concat(base.storms)) {
    const win = k => k.days.filter(x => x.d >= st.start && x.d <= st.end);
    const pb = Math.max(0, ...win(base).map(x => x.pNeg)), pw = Math.max(0, ...win(withIt).map(x => x.pNeg));
    if (st.end >= d && (!worst || pw - pb > worst.delta)) worst = { st, pb, pw, delta: pw - pb };
  }
  const dExp = withIt.expNeg - base.expNeg;
  // is there a better day in the next three weeks?
  let best = null;
  if (dExp > 0.3) {
    for (let k = 1; k <= 21; k++) {
      const dd = d + k; if (dd >= model.asOf + (opts.horizon || 56)) break;
      const r = simulate(model, scen, { ...opts, runs: 200, extra: { d: dd, amt } });
      const de = r.expNeg - base.expNeg;
      if (!best || de < best.dExp - 0.2) best = { d: dd, dExp: de };
    }
    if (best && best.dExp > dExp - 0.3) best = null;
  }
  return { base, withIt, dExp, worst, best };
}

// ---------- shocks: life's unexpected events ----------
const SHOCKS = [
  { id: 'bike', icon: '🚲', title: 'My e-bike breaks', what: 'A £180 repair, and about half a week of deliveries lost', type: 'expense',
    build: d => [{ kind: 'expense', d, amt: 180 }, { kind: 'income', from: d, to: d + 7, factor: 0.5 }] },
  { id: 'ill', icon: '🤒', title: "I'm ill for a week", what: 'No delivery pay for a week. Self-employed riders get no sick pay', type: 'income',
    build: d => [{ kind: 'income', from: d + 1, to: d + 7, factor: 0 }] },
  { id: 'washer', icon: '🧺', title: 'Washing machine breaks', what: 'A £320 replacement', type: 'expense',
    build: d => [{ kind: 'expense', d, amt: 320 }] },
  { id: 'ratecut', icon: '📉', title: 'Delivery app cuts pay', what: 'Pay per order drops 15% from then on', type: 'income',
    build: d => [{ kind: 'income', from: d, to: d + 9999, factor: 0.85 }] },
  { id: 'rent', icon: '🏠', title: 'Rent goes up £50', what: 'A £50 a month rent rise from then on', type: 'bill',
    build: d => [{ kind: 'rent', from: d, amt: 50 }] },
];
function shockTest(model, scen, shockId, d, opts = {}) {
  const sk = SHOCKS.find(x => x.id === shockId);
  const H = opts.horizon || 364, w = [d, Math.min(model.asOf + H - 1, d + (opts.weeks || 8) * 7)];
  const o = { horizon: H, runs: opts.runs || 300, window: w };
  const before = simulate(model, scen, o);
  const after = simulate(model, scen, { ...o, shocks: sk.build(d) });
  // UC reacts to lower earnings: extra UC in the following payments
  let ucUp = 0; for (const [k, v] of Object.entries(after.ucMed)) { const dd = +k; if (dd >= d && dd <= w[1] + 35) ucUp += v - (before.ucMed[dd] || 0); }
  const shieldAt = scen.shield ? before.days[d - model.asOf]?.sh50 ?? 0 : null;
  const cost = sk.build(d).reduce((t, x) => t + (x.kind === 'expense' ? x.amt : 0), 0);
  return { shock: sk, d, window: w, before, after, ucUp, shieldAt, cost,
    pBefore: before.pWin, pAfter: after.pWin, lowBefore: before.lowWin, lowAfter: after.lowWin, shieldUsedAfter: after.shieldUsed };
}

// ---------- Storm Shield: a ring-fenced emergency buffer ----------
function shieldSuggest(model, scen) {
  // start after the last storm in the next 12 weeks under this plan (or the next payday)
  const r12 = simulate(model, scen, { horizon: 84, runs: 300 });
  let startD = model.asOf; while (ymd(startD).wd !== model.gig.anchor) startD++;
  if (r12.storms.length) { startD = r12.storms[r12.storms.length - 1].end + 1; while (ymd(startD).wd !== model.gig.anchor) startD++; }
  // spare money per week after that, smoothed over whole months
  const r = simulate(model, scen, { horizon: 364, runs: 300 });
  const avg = (a, b) => mean(r.days.filter(x => x.d >= a && x.d < b).map(x => x.p50));
  const k0 = startD, k1 = Math.min(model.asOf + 363 - 28, startD + 182);
  const perWeek = (avg(k1, k1 + 28) - avg(k0, k0 + 28)) / ((k1 - k0) / 7);
  const weekly = Math.max(5, Math.min(30, Math.floor((perWeek * 0.5) / 5) * 5));
  return { start: startD, weekly, perWeek, target: 300 };
}

// backtest: forecast from a past date, compare with what actually happened
function backtest(hist, asOf, H = 28) {
  const m = analyse(hist.tx, asOf);
  const r = simulate(m, {}, { horizon: H, runs: 300 });
  const actual = [];
  let b = m.balance;
  for (let k = 0; k < H; k++) { const d = asOf + k; for (const t of hist.tx) if (t.d === d) b = t.bal; actual.push(b); }
  let inBand = 0, err = 0;
  r.days.forEach((x, k) => { if (actual[k] >= x.p10 && actual[k] <= x.p90) inBand++; err += Math.abs(actual[k] - x.p50); });
  return { asOf, H, coverage: inBand / H, mae: err / H, res: r, actual };
}

const ENGINE = { dn, ymd, fmtDay, DOW, MON, MONL, PERSONA, FIXES, SHOCKS, shockTest, shieldSuggest, generateHistory, analyse, simulate, fixImpacts, affordCheck, backtest, prettyName, median, mean };
if (typeof module !== 'undefined') module.exports = ENGINE;

