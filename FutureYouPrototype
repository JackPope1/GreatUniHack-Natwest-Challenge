    if (sh.kind === 'expense' && sh.d >= start && sh.d < start + H) shockOut[sh.d - start] += sh.amt;
    if (sh.kind === 'income') for (let k = Math.max(0, sh.from - start); k < H && start + k <= sh.to; k++) gigMul[k] *= sh.factor;
    if (sh.kind === 'rent') rentRise = sh;
  }
  if (extra && extra.d >= start && extra.d < start + H) shockOut[extra.d - start] += extra.amt;
  const sched = buildSchedule(model, scen, start, H);
  // per-day facts, computed once
  const info = Array.from({ length: H }, (_, k) => {
    const d = start + k, a = ymd(d);
    return { d, a, bF: bucket(d), bG: bucket(d - 6), isUC: a.d <= 20 && d === ucPayDate(a.y, a.m, model.ucParams.payDay),
      rentExtra: rentRise && d >= rentRise.from ? sched[k].filter(e => e.label === 'Rent').length * rentRise.amt : 0 };
  });
  // childcare paid each day (for the UC childcare element)
