    text:() => { const r = shockRes(resScen(), 'washer', 'next'); return `One £320 surprise next week, and even with the plan she's back to <b>${pct(r.pAfter)}</b>. She needs a buffer.`; } },
  { title:'A Storm Shield', spot:() => lastCard('shield'), go(){ chipSay('Turn it on'); },
    text:() => `A buffer that fills itself from the spare money her plan frees up: <b>${money(shieldCfg().weekly)} a week</b>, only when £150 is left. It covers dips automatically.` },
  { title:'The next 12 months', spot:() => lastCard('year'), go(){ chipSay('Show me the year'); },
    text:() => { const y0 = year({}), y1 = year(resScen()); return `From <b>${monthsRed(y0)} months in the red to ${monthsRed(y1)}</b>, the high-cost loan gone by April, and about <b>${money(y1.days[363].p50 + (y1.shieldEndMed || 0))}</b> by next November.`; } },
  { title:'“Can I afford it?”', spot:() => lastCard('afford'), go(){ chipSay('£60 trainers on 14 Nov'); },
    text:() => `Every purchase checked against her future, not just today's balance.` },
  { title:'Ask anything', spot:() => document.querySelector('.composer'), go(){ setTimeout(() => { const i = $('#q'); if (i) i.value = 'Should I pay my credit card or save for January?'; }, 0); },
    text:() => `Typed questions go to <b>Claude</b>, live. It calls the forecast engine as tools and answers with these cards, so <b>it can't make up numbers</b>.` },
  { title:'Forecast at a glance', spot:() => document.getElementById('fchart'), go(){ S.tab = 'forecast'; S.fview = 'plan'; },
    text:() => `One clear chart and 12 weeks of money weather. Her old future is the grey line, her new one is green.` },
  { title:'Her plan in one place', spot:() => document.querySelector('.screen .panel'), go(){ S.tab = 'plan'; },
    text:() => `Every change, the Storm Shield and the year ahead, each one switchable. Nothing happens until she chooses it.` },
  { title:'Built for everyone', spot:() => document.querySelector('.sheet'), go(){ S.sheet = { type:'settings' }; },
    text:() => `Simple words, large text, high contrast and replies read aloud. It never moves money or judges, and is never used for lending.` },
  { title:'Future You', spot:() => null, go(){ S.sheet = null; S.tab = 'coach'; },
    text:() => `See the storm. Understand it. Change the future.<br><span style="opacity:.75">An AI coach for the people banks find hardest to serve.</span>` },
];
function tourGo(i){
  i = Math.max(0, Math.min(TOUR.length - 1, i));
  const playing = S.tour ? S.tour.playing : false;
  resetAll(); S.instant = true; S.tour = { i, playing };
  for (let k = 0; k <= i; k++) TOUR[k].go();
  S.instant = false;
  render();
  clearTimeout(tourGo.t);
  if (S.tour.playing) tourGo.t = setTimeout(() => { if (!S.tour) return; if (S.tour.i < TOUR.length - 1) tourGo(S.tour.i + 1); else { S.tour.playing = false; renderSide(); } }, 9000);
}
function tourStart(play){ S.tour = { i:0, playing:!!play }; document.body.classList.add('touring'); tourGo(0); }
function tourStop(){ clearTimeout(tourGo.t); S.tour = null; document.body.classList.remove('touring'); render(); }
function applySpot(){
  document.querySelectorAll('.spot').forEach(e => e.classList.remove('spot'));
  if (!S.tour) return;
  const el = TOUR[S.tour.i].spot(); if (!el) return;
  el.classList.add('spot');
  const scr = $('#screen');
  if (scr.contains(el)) { const er = el.getBoundingClientRect(), sr = scr.getBoundingClientRect(), off = er.top - sr.top + scr.scrollTop; scr.scrollTop = er.height > scr.clientHeight - 20 ? off - 10 : off - (scr.clientHeight - er.height) / 2; }
}
function tourPanel(){
  const st = TOUR[S.tour.i], n = TOUR.length, i = S.tour.i;
  return `<div class="tourpanel" aria-live="polite"><div class="kick">Future You · guided demo</div>
    <div class="tstep">${i + 1} <span>/ ${n}</span></div><h1 class="ttitle">${esc(st.title)}</h1><p class="ttext">${st.text()}</p>
    <div class="tbar" aria-hidden="true"><span style="width:${(i + 1) / n * 100}%"></span></div>
    <div class="tctl"><button class="btn ghost" data-act="tprev" ${i === 0 ? 'disabled' : ''}>← Back</button><button class="btn" data-act="tplay">${S.tour.playing ? '⏸ Pause' : '▶ Play'}</button><button class="btn ghost" data-act="tnext" ${i === n - 1 ? 'disabled' : ''}>Next →</button><button class="btn ghost" data-act="tstop">✕ Exit</button></div>
    <div class="small" style="margin-top:14px">Keys: → next · ← back · space play/pause · Esc exit. Every number is calculated live.</div></div>`;
}

// ---------- render + events ----------
function scrollChat(){ const scr = $('#screen'); scr.scrollTop = scr.scrollHeight; }
function render(){
  document.body.style.setProperty('--fs', S.size);
  document.body.classList.toggle('contrast', S.contrast);
  document.body.classList.toggle('nomotion', !S.motion);
  renderTop();
  $('#screen').innerHTML = ({ coach:viewCoach, forecast:viewForecast, plan:viewPlan })[S.tab]();
  renderComposer(); renderSheet(); renderSide();
  if (S.tab === 'coach') scrollChat();
  if (S.tour) applySpot();
}
function toast(t){ const el = $('#toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove('show'), 2000); }
document.addEventListener('click', e => {
  const t = e.target.closest('[data-tab],[data-act]'); if (!t) return;
  if (t.dataset.tab) { S.tab = t.dataset.tab; render(); if (S.tab !== 'coach') $('#screen').scrollTop = 0; return; }
  const a = t.dataset.act, v = t.dataset.v, keep = $('#screen').scrollTop;
  switch (a) {
    case 'qr': userAsk(v, true); return;
    case 'tab': S.tab = v; render(); $('#screen').scrollTop = 0; return;
    case 'fix': S.plan.has(v) ? S.plan.delete(v) : S.plan.add(v); toast(S.plan.has(v) ? `Added: ${SHORT[v]}` : `Removed: ${SHORT[v]}`); if (!S.plan.size) S.shieldOn = false; break;
    case 'draft': S.sheet = { type:'draft', id:v }; break;
    case 'shock': userAsk(`What if ${{ bike:'my e-bike breaks', ill:"I'm ill for a week", washer:'my washing machine breaks', ratecut:'the delivery app cuts my pay', rent:'my rent goes up £50' }[v]} next week?`, true); return;
    case 'shieldon': userAsk('Turn it on', true); return;
    case 'shieldtoggle': if (t.disabled) return; S.shieldOn = !S.shieldOn; toast(S.shieldOn ? 'Storm Shield on' : 'Storm Shield off'); break;
    case 'fview': S.fview = v; break;
    case 'week': S.selWeek = +v; break;
    case 'askweek': { const w = weeks(S.fview === 'plan' && S.plan.size ? planned() : base())[+v]; S.tab = 'coach'; render(); userAsk(`Why is the week of ${E.fmtDay(w.start)} ${WXW[w.w] === 'clear' ? 'looking fine' : 'risky'}?`, true); return; }
    case 'settings': S.sheet = { type:'settings' }; break;
    case 'closesheet': if (t.classList.contains('sheet-bg') && e.target !== t) return; S.sheet = null; break;
    case 'simple': S.simple = v === '1'; break;
    case 'size': S.size = +v; break;
    case 'contrast': S.contrast = !S.contrast; break;
    case 'motion': S.motion = !S.motion; break;
    case 'speak': S.speak = !S.speak; break;
    case 'live': S.live = !S.live; renderComposer(); return;
    case 'copy': try { navigator.clipboard.writeText(DRAFTS[v]).then(() => toast('Copied. Paste it into an email or text'), () => toast('Select the text to copy it')); } catch (_) { toast('Select the text to copy it'); } return;
    case 'reset': resetAll(); render(); return;
    case 'tour': tourStart(false); return;
    case 'tnext': tourGo(S.tour.i + 1); return;
    case 'tprev': tourGo(S.tour.i - 1); return;
    case 'tplay': S.tour.playing = !S.tour.playing; tourGo(S.tour.i); return;
    case 'tstop': tourStop(); return;
    default: return;
  }
  render(); if (S.tab !== 'coach') $('#screen').scrollTop = keep;
});
document.addEventListener('submit', e => { if (e.target.dataset.act === 'send') { e.preventDefault(); const q = $('#q').value; userAsk(q, false); } });
document.addEventListener('keydown', e => {
  if (S.tour && !(e.target && e.target.tagName === 'INPUT')) {
    if (e.key === 'ArrowRight' || e.key === 'PageDown') { e.preventDefault(); tourGo(S.tour.i + 1); return; }
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); tourGo(S.tour.i - 1); return; }
    if (e.key === ' ') { e.preventDefault(); S.tour.playing = !S.tour.playing; tourGo(S.tour.i); return; }
    if (e.key === 'Escape') { tourStop(); return; }
  }
  if (e.key === 'Escape' && S.sheet) { S.sheet = null; render(); }
});
window.__tour = { start:tourStart, go:tourGo, stop:tourStop, n:() => TOUR.length };
window.__ask = (q, chip) => userAsk(q, chip);
render();
if (location.hash === '#tour') tourStart(false);
})();
</script>
</body>
</html>
