    if (wd === 6 && r() < 0.3) add(d, 'JUST EAT', -Math.max(8, 14 + gauss(r) * 4), 'Takeaways');
    if (wd >= 1 && wd <= 5 && r() < 0.3) add(d, 'BEE NETWORK BUS', -2, 'Transport');
    if (r() < 0.035) add(d, 'BIKEFIX MANCHESTER', -(20 + r() * 60), 'Work costs');
    if (r() < 0.24) add(d, ['PRIMARK', 'HOME BARGAINS', 'CARD FACTORY', 'BOOTS'][Math.floor(r() * 4)], -(4 + r() * 21), 'Kids & home');
    if (wd === 0 && r() < 0.3) add(d, 'CASH ATM', -20, 'Cash');
    if (xmas && r() < 0.42) add(d, ['ARGOS', 'SMYTHS TOYS', 'AMAZON'][Math.floor(r() * 3)], -(15 + r() * 45), 'Christmas');
    if (a.m === 8 && a.d === 20) add(d, 'SCHOOL UNIFORM DIRECT', -78, 'Kids & home');
